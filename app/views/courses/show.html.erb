<p style="color: green"><%= notice %></p>

<%= render @course %>

<div> 
  <% unless @student.courses.include?(@course) %>
    <%= button_to  "Enroll Course", new_school_student_term_course_course_enrollment_path(@course.term.school, @student, @course.term, @course), method: :get %>
  <% end %>

  <%= link_to "Back to courses", school_student_term_path(@course.term.school, @student, @course.term) %>
</div>
