<p style="color: green"><%= notice %></p>

<%= render @term %>

<h2>Accessible Courses</h2>
<%= render_course_list(@student, @accessible_courses) %>

<h2>Available Courses</h2>
<%= render_course_list(@student, @available_courses) %>


<div>
  <%= link_to "Back to terms", school_student_path(@term.school, @student) %>

  <% unless @student.terms.include?(@term) %>
    <%= button_to  "Grant Access", new_school_student_term_term_access_path(@term.school, @student, @term), method: :get %>
  <% end %>
</div>
