<h3>Pay with License</h3>
<%= form_with(model: [@school, @student, @term, @term_access]) do |form| %>
  <%= form.hidden_field :payment_method, value: 'license' %>

  <div>
    <%= form.label :license_code, 'License Code' %><br>
    <%= form.text_field :license_code %>
  </div>

  <%= form.submit 'Pay with License' %>
<% end %>

<h3>Pay with Credit Card</h3>
<%= form_with(model: [@school, @student, @term, @term_access]) do |form| %>
  <%= form.hidden_field :payment_method, value: 'credit_card' %>

  <div>
    <%= form.label :credit_card_num, 'Credit Card Number' %><br>
    <%= form.text_field :credit_card_num %>
  </div>

  <%= form.submit 'Pay with Credit Card' %>
<% end %>
