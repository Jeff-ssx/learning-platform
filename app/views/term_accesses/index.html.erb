<p style="color: green"><%= notice %></p>

<h1>Term accesses</h1>

<div id="term_accesses">
  <% @term_accesses.each do |term_access| %>
    <%= render term_access %>
    <p>
      <%= link_to "Show this term access", term_access %>
    </p>
  <% end %>
</div>

<%= link_to "New term access", new_term_access_path %>
